# Copy to .env and fill in. Values below work for local Docker Compose.
DATABASE_URL=postgresql+psycopg://app:app@db:5432/datafog
TEST_DATABASE_URL=postgresql+psycopg://app:app@db:5432/datafog_test
READONLY_DATABASE_URL=
REDIS_URL=redis://redis:6379
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONFIG_ENCRYPTION_KEY=
COOKIE_SECURE=false
# Chat uses any OpenAI-compatible API. Defaults: NVIDIA (build.nvidia.com, key starts with nvapi-)
# and nvidia/nemotron-3.5-lightning-30b-a3b. The model must support tool calling.
LLM_API_KEY=
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Auto-Docs: one JSON answer per asset, so a small fast model. Empty = same as LLM_*.
DOCS_API_KEY=
DOCS_MODEL=nvidia/nemotron-3.5-bolt-e4b
# Embeddings use any OpenAI-compatible API. Defaults: Gemini (key from aistudio.google.com) and
# gemini-embedding-2 at 1536 dimensions. Leave the key empty to skip them (keyword search only).
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
EMBEDDING_MODEL=gemini-embedding-2
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
