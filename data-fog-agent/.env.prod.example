# Production settings. Copy to .env.prod on the server and fill in every value.
# Never commit .env.prod.

# The domain people open. Its DNS A record must point at this server before the first start.
DOMAIN=datafog.example.com

# Database passwords. Generate each with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=
APP_DB_PASSWORD=

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it safe: without it, saved source settings can't be decrypted.
CONFIG_ENCRYPTION_KEY=

# Chat: NVIDIA (build.nvidia.com). The model must support tool calling.
LLM_API_KEY=
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Auto-Docs: one JSON answer per asset, so a small fast model. Empty = same as LLM_*.
DOCS_API_KEY=
DOCS_MODEL=nvidia/nemotron-3.5-bolt-e4b

# Embeddings: Gemini (aistudio.google.com).
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
EMBEDDING_MODEL=gemini-embedding-2

# Optional: trace every model call in Langfuse (cloud.langfuse.com or self-hosted). Tracing is
# on when both keys are set. Traces hold what the model was sent, which is already PII-masked.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
